# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token

# Canopy Wave API key (https://cloud.canopywave.io)
CANOPYWAVE_API_KEY=your-canopywave-key

# Optional overrides
CANOPYWAVE_BASE_URL=https://api.canopywave.io/v1
TEXT_MODEL=minimax/minimax-m2.5
VISION_MODEL=zai/glm-5.1

# Optional separate provider for vision (e.g. OpenRouter). If empty, the same
# CANOPYWAVE_API_KEY + CANOPYWAVE_BASE_URL are reused for vision calls.
# VISION_API_KEYS may be comma-separated to round-robin across multiple
# OpenRouter accounts and effectively multiply the free-tier daily quota.
VISION_API_KEY=
VISION_API_KEYS=
VISION_BASE_URL=

# Inline mode uses a deliberately FAST model so the answer arrives within
# Telegram's ~10s inline_query timeout. Defaults route to the vision provider
# (typically OpenRouter, where small free models like gpt-oss-20b live).
INLINE_MODEL=openai/gpt-oss-20b:free
INLINE_API_KEY=
INLINE_BASE_URL=

# Optional third provider: ecomagent.in (OpenAI-compatible Claude Opus +
# Cursor LM proxy). When the key is set, the Claude Opus 4.6 and Cursor LM
# entries in the model picker become live; otherwise they're hidden from
# the API surface.
ECOMAGENT_API_KEY=
ECOMAGENT_BASE_URL=https://api.ecomagent.in/v1

# Public HTTPS URL where the Web App is reachable (for the Open Web App button).
# Leave empty to disable the Web App button in /start.
WEBAPP_URL=

# Web server bind config
HOST=0.0.0.0
PORT=8000

# Webhook mode (production deploys, e.g. Render). When set, the bot registers
# a webhook at <WEBHOOK_BASE_URL><WEBHOOK_PATH> instead of long-polling.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# Self-ping keep-alive (helpful on Render Free which sleeps after 15 min idle).
# When empty, defaults to <WEBHOOK_BASE_URL>/api/health if set, otherwise off.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=600

# Comma-separated Telegram user IDs allowed to use the bot. Leave empty for public access.
ALLOWED_USER_IDS=
