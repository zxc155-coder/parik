# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token

# Canopy Wave API key (https://cloud.canopywave.io)
CANOPYWAVE_API_KEY=your-canopywave-key

# Optional overrides
CANOPYWAVE_BASE_URL=https://api.canopywave.io/v1
TEXT_MODEL=minimax/minimax-m2.5
VISION_MODEL=zai/glm-5.1

# Optional separate provider for vision (e.g. OpenRouter). If empty, the same
# CANOPYWAVE_API_KEY + CANOPYWAVE_BASE_URL are reused for vision calls.
VISION_API_KEY=
VISION_BASE_URL=

# Public HTTPS URL where the Web App is reachable (for the Open Web App button).
# Leave empty to disable the Web App button in /start.
WEBAPP_URL=

# Web server bind config
HOST=0.0.0.0
PORT=8000

# Comma-separated Telegram user IDs allowed to use the bot. Leave empty for public access.
ALLOWED_USER_IDS=
